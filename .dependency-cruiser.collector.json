{
  "forbidden": [
    {
      "name": "api-connects-to-postgres-through-the-collector-database",
      "severity": "error",
      "from": { "path": "^apps/api/src/(?!storage/collector-database\\.ts$)" },
      "to": { "path": "(^|/)(pg|pg-pool)(/|$)", "dependencyTypesNot": ["type-only"] }
    },
    {
      "name": "http-handlers-do-not-open-databases",
      "severity": "error",
      "from": { "path": "^apps/api/src/collector-api\\.ts$" },
      "to": { "path": "^apps/api/src/storage/", "reachable": true }
    },
    {
      "name": "http-client-uses-the-wire-contract-and-storage-port",
      "severity": "error",
      "from": { "path": "^apps/collector/src/storage/http/http-collector-storage\\.ts$" },
      "to": { "path": "^apps/(?!collector/src/storage/(collector-storage|http/collector-wire-contract|http/packed-batch)\\.ts$)", "reachable": true }
    },
    {
      "name": "collector-api-depends-on-storage",
      "severity": "error",
      "from": { "path": "^apps/api/src/" },
      "to": { "path": "^apps/collector/src/(?!storage/)" }
    },
    {
      "name": "http-handlers-use-the-storage-port",
      "severity": "error",
      "from": { "path": "^apps/api/src/collector-api\\.ts$" },
      "to": { "path": "^apps/collector/src/storage/(?!(collector-storage|http/collector-wire-contract|http/packed-batch)\\.ts$)", "reachable": true }
    },
    {
      "name": "schedule-runs-the-scan-through-its-handler",
      "severity": "error",
      "from": { "path": "^apps/collector/src/watch/scheduled-scanner\\.ts$" },
      "to": { "path": "^apps/collector/src/(history/|storage/(?!collector-storage\\.ts$)|scan/local-collector\\.ts$)" }
    },
    {
      "name": "only-the-transcript-layer-reads-files",
      "severity": "error",
      "from": { "path": "^apps/collector/src/(history|providers|scan|watch)/" },
      "to": { "path": "^(node:)?fs(/promises)?$" }
    },
    {
      "name": "history-reads-through-the-provider-port",
      "severity": "error",
      "from": { "path": "^apps/collector/src/history/" },
      "to": { "path": "^apps/collector/src/(providers|transcript|scan|watch|storage|config|commands)/" }
    },
    {
      "name": "transcript-layer-is-provider-neutral",
      "severity": "error",
      "from": { "path": "^apps/collector/src/transcript/" },
      "to": { "path": "^apps/collector/src/(providers|scan|watch|storage|config|commands)/" }
    },
    {
      "name": "providers-do-not-know-each-other",
      "severity": "error",
      "from": { "path": "^apps/collector/src/providers/(codex|claude)/" },
      "to": { "path": "^apps/collector/src/providers/(codex|claude)/", "pathNot": "^apps/collector/src/providers/$1/" }
    },
    {
      "name": "providers-receive-their-paths",
      "severity": "error",
      "from": { "path": "^apps/collector/src/providers/(codex|claude)/" },
      "to": { "path": "^apps/collector/src/config/" }
    },
    {
      "name": "scan-engine-is-provider-neutral",
      "comment": "The scanner and the schedule know a provider only through the ScanProvider port. pathNot names local-collector.ts, which builds the two providers until step 3 gives them to it. Step 3 removes pathNot.",
      "severity": "error",
      "from": {
        "path": "^apps/collector/src/(scan|watch)/",
        "pathNot": "^apps/collector/src/scan/local-collector\\.ts$"
      },
      "to": { "path": "^apps/collector/src/providers/" }
    },
    {
      "name": "only-local-providers-names-both-providers",
      "comment": "Outside providers/, a file gets the providers from providers/index.ts.",
      "severity": "error",
      "from": { "path": "^apps/collector/src/(?!providers/)" },
      "to": { "path": "^apps/collector/src/providers/(codex|claude)/" }
    },
    {
      "name": "scanner-uses-only-the-storage-port",
      "severity": "error",
      "from": { "path": "^apps/collector/src/(scan|watch|providers)/" },
      "to": { "path": "^apps/collector/src/storage/(?!collector-storage\\.ts$)", "reachable": true }
    },
    {
      "name": "collector-uses-storage-port",
      "severity": "error",
      "from": { "path": "^apps/collector/src/" },
      "to": { "path": "(^apps/api/|(^|/)(@supabase/|pg(/|$)))" }
    },
    {
      "name": "production-excludes-test-code",
      "severity": "error",
      "from": { "path": "^(apps|packages)/[^/]+/(src|scripts)/" },
      "to": {
        "path": ["^(dist/)?test/", "^(apps|packages)/[^/]+/(dist/)?test/"],
        "reachable": true
      }
    },
    {
      "name": "history-receives-global-config",
      "severity": "error",
      "from": { "path": "^apps/collector/src/(history|providers|transcript)/" },
      "to": { "path": "^apps/collector/src/config/global-config-loader\\.ts$", "reachable": true }
    },
    {
      "name": "local-history-is-independent-of-storage",
      "severity": "error",
      "from": { "path": "^apps/collector/src/(history|transcript)/" },
      "to": { "path": "^apps/collector/src/storage/|(^|/)(better-sqlite3|node:sqlite)(/|$)" }
    },
    {
      "name": "storage-is-self-contained",
      "severity": "error",
      "from": { "path": "^apps/collector/src/storage/" },
      "to": { "path": "^apps/collector/src/(?!storage/)" }
    },
    {
      "name": "storage-port-is-independent",
      "severity": "error",
      "from": { "path": "^apps/collector/src/storage/collector-storage\\.ts$" },
      "to": { "path": "^apps/" }
    }
  ],
  "options": {
    "doNotFollow": { "path": "node_modules" },
    "enhancedResolveOptions": {
      "exportsFields": ["exports"],
      "conditionNames": ["types", "import", "node", "default"]
    },
    "tsPreCompilationDeps": true,
    "tsConfig": { "fileName": "tsconfig.json" }
  }
}
