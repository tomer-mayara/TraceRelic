{
  "ignoreBinaries": ["uvx"],
  "workspaces": {
    ".": {
      "entry": [".habit-hooks/eslint.config.mjs", "test/acceptance/**/*.{test,steps}.ts"],
      "ignoreDependencies": ["@typespec/json-schema", "jscpd", "ts-morph"]
    },
    "apps/*": {
      "entry": ["test/{unit,integration,interface,acceptance}/**/*.{test,steps}.ts", "src/cli.ts", "src/storage/collector-storage.ts", "scripts/*.mjs"],
      "project": ["{src,test}/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "test/{unit,integration,interface,acceptance}/**/*.{test,steps}.ts"],
      "project": ["{src,test}/**/*.{ts,tsx}"]
    }
  }
}
