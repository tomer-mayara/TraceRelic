{
  "ignoreBinaries": ["uvx"],
  "workspaces": {
    ".": {
      "entry": [".habit-hooks/eslint.config.mjs"],
      "ignoreDependencies": ["jscpd", "ts-morph"]
    },
    "apps/*": {
      "entry": ["src/**/*.test.{ts,tsx}", "scripts/*.mjs"],
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.{ts,mjs}"]
    },
    "packages/*": {
      "entry": ["src/index.ts", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
