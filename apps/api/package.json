{
  "name": "@tracerelic/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/collector-api.ts", "import": "./dist/collector-api.js" },
    "./*": "./*"
  },
  "imports": {
    "#src/*": { "types": "./src/*.ts", "default": "./dist/*.js" }
  },
  "scripts": {
    "contract": "tsp compile ../../docs/specs/collector-api/main.tsp --pretty false",
    "compile": "bun run contract && swc src -d dist --strip-leading-paths --config-file ../../.swcrc && swc test -d dist/test --delete-dir-on-start --strip-leading-paths --config-file ../../.swcrc",
    "check:collector-scenarios": "cucumber-js test/acceptance/collector/workspace.feature --import ./dist/test/acceptance/collector/workspace.steps.js --format summary && cucumber-js ../collector/test/acceptance/storage/storage.feature --import ../collector/dist/test/acceptance/storage/storage.steps.js --import ./dist/test/acceptance/collector/storage-over-http.steps.js --format summary"
  },
  "dependencies": {
    "@tracerelic/collector": "workspace:*",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@types/pg": "8.23.1"
  }
}
